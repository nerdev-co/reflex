// Reflex data model — see docs/03-data-model.md for the rationale behind every table.
// Conventions:
//  - The DB is the source of truth; the queue is just a delivery mechanism.
//  - Runs are immutable history — run tables never cascade from config tables.

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Enums
enum WorkflowStatus {
    DRAFT
    ENABLED
    DISABLED
}

enum TriggerType {
    POLL
    WEBHOOK
    SCHEDULE
}

enum TriggerStateKind {
    CURSOR
    SUBSCRIPTION
}

enum RunStatus {
    PENDING
    RUNNING
    SUCCEEDED
    FAILED
}

enum StepRunStatus {
    QUEUED
    RUNNING
    RETRYING
    SUCCEEDED
    FAILED
    SKIPPED
    SUPERSEDED
}

// 1. Identity & auth
model User {
    id           String   @id @default(cuid())
    email        String   @unique
    passwordHash String
    createdAt    DateTime @default(now())

    sessions    Session[]
    workflows   Workflow[]
    credentials Credential[]
}

model Session {
    id        String   @id @default(cuid())
    tokenHash String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// 2. Configuration
model Workflow {
    id            String         @id @default(cuid())
    name          String
    triggerKey    String
    triggerConfig Json
    status        WorkflowStatus @default(DRAFT)
    version       Int            @default(1)
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    versions      WorkflowVersion[]
    steps         Step[]
    triggerStates TriggerState[]
    runs          ZapRun[]
    // webhook + secret generated on enable (see docs/06-api-and-auth.md)
    webhookPath   String?           @unique
    webhookSecret String?

    @@index([userId])
}

model WorkflowVersion {
    id         String   @id @default(cuid())
    version    Int
    definition Json // full snapshot: triggerConfig + ordered steps with configs
    createdAt  DateTime @default(now())

    workflowId String
    workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

    @@unique([workflowId, version])
}

model Step {
    id        String  @id @default(cuid())
    position  Int
    actionKey String
    config    Json
    enabled   Boolean @default(true)

    workflowId String
    workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

    stepRuns StepRun[]

    @@unique([workflowId, position])
    @@index([workflowId])
}

model AvailableTrigger {
    key      String      @id
    noun     String
    type     TriggerType
    metadata Json // inputFields, sample, polling interval, etc.
}

model AvailableAction {
    key            String  @id
    noun           String
    idempotentSafe Boolean @default(true)
    metadata       Json // inputFields, sample, etc.
}

model TriggerState {
    id        String           @id @default(cuid())
    kind      TriggerStateKind
    state     Json // poll cursors (last-seen ids) or webhook subscriptions
    updatedAt DateTime         @updatedAt

    workflowId String
    workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

    @@index([workflowId])
}

model Credential {
    id        String   @id @default(cuid())
    actionKey String
    label     String
    config    Json // secrets AES-GCM encrypted at rest; decrypted only in the worker
    createdAt DateTime @default(now())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// 3. Execution history — the trace (immutable)
model ZapRun {
    id             String    @id @default(cuid())
    triggerKey     String
    triggerPayload Json // FULL incoming payload, verbatim — enables replay
    status         RunStatus @default(PENDING)
    createdAt      DateTime  @default(now())
    startedAt      DateTime?
    finishedAt     DateTime?

    workflowId      String?
    workflow        Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
    workflowVersion Int? // bind to the version that executed (load-bearing, ADR-07)

    // Provenance: set only on replays. Original runs are never mutated.
    replayOfRunId String?
    replayOfRun   ZapRun?  @relation("Replay", fields: [replayOfRunId], references: [id], onDelete: SetNull)
    replayedRuns  ZapRun[] @relation("Replay")

    stepRuns StepRun[]
    events   RunEvent[]

    @@index([workflowId])
    @@index([status])
}

model StepRun {
    id            String        @id @default(cuid())
    stepKey       String // snapshot of the definition key
    status        StepRunStatus @default(QUEUED)
    config        Json // snapshot of the step's template config
    attemptCount  Int           @default(0)
    output        Json? // last output (skipped steps inherit here)
    workerId      String?
    enqueuedAt    DateTime      @default(now())
    claimedAt     DateTime?
    startedAt     DateTime?
    finishedAt    DateTime?
    nextAttemptAt DateTime? // retry schedule — the reaper's clock

    runId String
    run   ZapRun @relation(fields: [runId], references: [id], onDelete: Cascade)

    stepId String?
    step   Step?   @relation(fields: [stepId], references: [id], onDelete: SetNull)

    // Set when a replay inherits a completed step (ADR-06)
    inheritedFromStepRunId String?
    inheritedFromStepRun   StepRun?  @relation("Inherited", fields: [inheritedFromStepRunId], references: [id], onDelete: SetNull)
    inheritedStepRuns      StepRun[] @relation("Inherited")

    attempts StepRunAttempt[]

    @@index([runId])
    @@index([status, nextAttemptAt]) // reaper: due retries
    @@index([status, claimedAt]) // reaper: stale claims
}

model StepRunAttempt {
    id         String   @id @default(cuid())
    attemptNo  Int
    input      Json // payload ACTUALLY passed to perform (resolved, not template)
    output     Json? // payload ACTUALLY returned
    error      Json? // { class, message, stack, httpStatus }
    httpTrace  Json? // request/response headers + body per attempt
    durationMs Int?
    createdAt  DateTime @default(now())

    stepRunId String
    stepRun   StepRun @relation(fields: [stepRunId], references: [id], onDelete: Cascade)

    @@unique([stepRunId, attemptNo])
    @@index([stepRunId])
}

model RunEvent {
    id   String   @id @default(cuid())
    type String // step_claimed, retry_scheduled, step_succeeded, replay_created, …
    data Json
    at   DateTime @default(now())

    runId String
    run   ZapRun @relation(fields: [runId], references: [id], onDelete: Cascade)

    @@index([runId, at])
}
